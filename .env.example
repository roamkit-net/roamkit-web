# Local development — copy to .env.local (never commit secrets)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional canonical origin for Reown AppKit metadata (defaults to window.origin / roamkit.net)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Reown Cloud project ID — required for WalletConnect deposits on /me/deposit
# https://dashboard.reown.com
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Cloudflare Turnstile site key (leave empty locally; set with API TURNSTILE_ENABLED)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Google OAuth GIS client ID (leave empty to hide Continue with Google)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Android Install eSIM CTA (esimsetup.android.com). Staging/prod bake via GitHub
# Actions vars NEXT_PUBLIC_ANDROID_LPA_DEEP_LINK / _PRODUCTION (empty = off).
# NEXT_PUBLIC_ANDROID_LPA_DEEP_LINK=1
# Geo-aware Popular ranking on /plans (server-only; default true when unset)
# POPULAR_GEO_RANKING_ENABLED=true
